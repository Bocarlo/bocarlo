---
import Layout from "../layouts/Layout.astro";

import { Icon } from "astro-icon/components";
import bocarlo1 from "/bocarlo1.jfif";
import bocarlo2 from "/bocarlo2.jfif";
import grodzisko from "/grodzisko.jfif";
import bocarlo_zima from "/bocarlo_zima.jfif";
import bocarlozt from "/bocarlozt.jfif";
import bocarlozg from "/bocarlozg.jfif";
import onas from "/onas.jfif";
import kontaktImg from "/kontakt.jfif";
---

<Layout>
  <!-- Hero sekcja ze zdjęciem -->
  <section class="relative w-full flex flex-col items-center justify-center pb-22 pt-40 -mt-20">
    <div
      class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden"
      style="z-index:0;"
    >
      <div
        id="parallax-hero"
        class="absolute inset-0 w-full bg-cover bg-center opacity-70 will-change-transform"
        style={`background-image: url('${bocarlo_zima}'); height: 130%; top: -15%;`}
      ></div>
      <div
        class="absolute inset-0 w-full h-full"
        style="backdrop-filter: blur(6px); background: rgba(255,255,255,0.2);"
      >
      </div>
    </div>
    <div class="relative z-10 max-w-5xl mx-auto w-full text-center px-4 md:px-6">
      <div
        class="rounded-2xl mx-auto max-w-3xl px-5 py-8 md:px-8 md:py-10 backdrop-blur-xl bg-white/55 shadow-xl border border-black/25"
        style="box-shadow:0 16px 48px 0 rgba(0,0,0,0.16);"
      >
        <h1
          class="text-3xl md:text-5xl font-semibold mb-3 md:mb-6 text-[var(--color-primary)]"
        >
          Bocarlo – Twoje miejsce na wyjątkowe chwile
        </h1>
        <p
          class="text-md md:text-lg text-[var(--color-text)] mb-2 md:mb-4"
        >
          Zapraszamy do Bocarlo – nowoczesnej przestrzeni, gdzie każda
          uroczystość nabiera indywidualnego charakteru. Odkryj miejsce, które
          łączy elegancję z rodzinną atmosferą.
        </p>
        <p class="mt-4 text-sm md:text-md text-black/90">
          Tworzymy wspomnienia, które zostają na lata.
        </p>
      </div>
    </div>
  </section>

  <!-- Sekcja z ikonami atutów -->
  <section class="w-full py-12 md:py-16 bg-black border-y border-white/10">
    <div
      class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 text-center px-4 md:px-6"
    >
      <div class="flex flex-col items-center rounded-2xl border border-black/20 bg-white p-6 shadow-lg">
        <!-- Ikona gwiazdek -->
        <Icon
          name="mdi:stars"
          class="w-24 h-24 mb-4 text-black bg-black/5 shadow-sm p-4 border border-black/20 rounded-xl"
        />
        <h3 class="text-xl font-bold text-[var(--color-accent)] mb-2">
          Eleganckie wnętrza
        </h3>
        <p class="text-[var(--color-text)]">
          Wyjątkowy wystrój i dbałość o detale.
        </p>
      </div>
      <div class="flex flex-col items-center rounded-2xl border border-black/20 bg-white p-6 shadow-lg">
        <!-- Ikona jedzenia -->
        <Icon
          name="mdi:food-turkey"
          class="w-24 h-24 mb-4 text-black bg-black/5 shadow-sm p-4 border border-black/20 rounded-xl"
        />
        <h3 class="text-xl font-bold text-[var(--color-accent)] mb-2">
          Wyśmienita kuchnia
        </h3>
        <p class="text-[var(--color-text)]">
          Menu dopasowane do Twoich potrzeb.
        </p>
      </div>
      <div class="flex flex-col items-center rounded-2xl border border-black/20 bg-white p-6 shadow-lg">
        <!-- Ikona kelnerów -->
        <Icon
          name="mdi:person-multiple-check"
          class="w-24 h-24 mb-4 text-black bg-black/5 shadow-sm p-4 border border-black/20 rounded-xl"
        />
        <h3 class="text-xl font-bold text-[var(--color-accent)] mb-2">
          Profesjonalna obsługa
        </h3>
        <p class="text-[var(--color-text)]">
          Zespół, który zadba o każdy szczegół.
        </p>
      </div>
    </div>
  </section>

  <!-- Sekcja o nas -->
  <section class="w-full bg-[var(--color-background)]">
    <div
      class="max-w-5xl mx-auto flex flex-col md:flex-row items-stretch min-h-[420px]"
    >
      <img
        src={onas}
        alt="O nas"
        class="w-full h-64 md:h-auto md:w-1/2 object-cover object-center flex-shrink-0"
        loading="lazy"
      />
      <div class="w-full flex flex-col justify-center px-8 md:px-14 py-10 md:py-14">
        <h2
          class="text-2xl md:text-3xl font-bold text-[var(--color-accent)] mb-3 md:mb-4"
        >
          O nas
        </h2>
        <p class="text-base md:text-lg text-[var(--color-text)] mb-2">
          Bocarlo to miejsce stworzone z pasji do organizacji niezapomnianych
          wydarzeń. Łączymy nowoczesność z tradycją, oferując przestrzeń, która
          inspiruje i zachwyca.
        </p>
        <p class="text-sm md:text-md text-[var(--color-muted)]">
          Zaufaj nam – zrealizujemy Twoją wizję perfekcyjnie.
        </p>
      </div>
    </div>
  </section>

  <!-- Sale -->
  <section id="sale" class="w-full py-14 md:py-16 bg-black border-y border-white/10">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2
        class="text-3xl font-semibold text-center text-white mb-10"
      >
        Nasze sale
      </h2>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8"
        id="sale-gallery"
      >
        <div class="flex flex-col items-center group">
          <a
            href={bocarlo1}
            data-pswp-width="1200"
            data-pswp-height="800"
            data-pswp-src={bocarlo1}
            data-pswp-caption="Sala kryształowa – Tryńcza"
            class="block w-full"
          >
            <img
              src={bocarlo1}
              alt="Sala kryształowa"
              class="w-full h-64 object-cover rounded-xl shadow-md border border-black/20 group-hover:scale-[1.02] group-hover:shadow-xl transition-all duration-300"
              loading="lazy"
            />
          </a>
          <span
            class="mt-3 text-lg font-semibold text-white group-hover:translate-y-1 group-hover:scale-105 transition-all duration-300"
            >Sala kryształowa</span
          >
          <span
            class="text-sm text-white/80 mt-1 group-hover:scale-105 transition-all duration-300 group-hover:translate-y-1"
            >Tryńcza</span
          >
        </div>
        <div class="flex flex-col items-center group">
          <a
            href={bocarlo2}
            data-pswp-width="1200"
            data-pswp-height="800"
            data-pswp-src={bocarlo2}
            data-pswp-caption="Sala szklana – Tryńcza"
            class="block w-full"
          >
            <img
              src={bocarlo2}
              alt="Sala szklana"
              class="w-full h-64 object-cover rounded-xl shadow-md border border-black/20 group-hover:scale-[1.02] group-hover:shadow-xl transition-all duration-300"
              loading="lazy"
            />
          </a>
          <span
            class="mt-3 text-lg font-semibold text-white group-hover:scale-105 group-hover:translate-y-1 transition-all duration-300"
            >Sala szklana</span
          >
          <span
            class="text-sm text-white/80 mt-1 group-hover:translate-y-1 group-hover:scale-105 transition-all duration-300"
            >Tryńcza</span
          >
        </div>
        <div class="flex flex-col items-center group">
          <a
            href={grodzisko}
            data-pswp-width="1200"
            data-pswp-height="800"
            data-pswp-src={grodzisko}
            data-pswp-caption="Sala Grodzisko – Grodzisko Dolne"
            class="block w-full"
          >
            <img
              src={grodzisko}
              alt="Sala Grodzisko"
              class="w-full h-64 object-cover rounded-xl shadow-md border border-black/20 group-hover:scale-[1.02] group-hover:shadow-xl transition-all duration-300"
              loading="lazy"
            />
          </a>
          <span
            class="mt-3 text-lg font-semibold text-white group-hover:translate-y-1 group-hover:scale-105 transition-all duration-300"
            >Sala Grodzisko</span
          >
          <span
            class="text-sm text-white/80 mt-1 group-hover:translate-y-1 group-hover:scale-105 transition-all duration-300"
            >Grodzisko Dolne</span
          >
        </div>
      </div>
      <!-- Photoswipe root element -->
      <div class="pswp" tabindex="-1" role="dialog" aria-hidden="true"></div>
    </div>
    <div class="mt-10 text-center">
      <a
        href="https://www.facebook.com/profile.php?id=100057527347729&sk=photos"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center justify-center gap-2 md:gap-3 px-4 py-2.5 md:px-6 md:py-3 rounded-xl md:rounded-2xl bg-white text-black font-semibold border border-black/20 shadow-lg hover:shadow-2xl hover:-translate-y-0.5 transition-all duration-300 ease-out text-sm md:text-lg"
        style="box-shadow:0 10px 30px 0 rgba(0,0,0,0.14);"
      >
        <Icon
          name="mdi:facebook"
          class="w-6 h-6 text-black transition-transform duration-300 group-hover:scale-110 pb-0.5"
        />
        <span class="tracking-wide">Zobacz więcej zdjęć na Facebooku</span>
        <Icon
          name="mdi:arrow-top-right"
          class="w-4 h-4 md:w-5 md:h-5 text-black transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </section>

  <!-- ...istniejące sekcje oferta, kontakt... -->

  <!-- Photoswipe CDN & inicjalizacja -->
  <script
    src="https://unpkg.com/photoswipe@5/dist/photoswipe-lightbox.esm.min.js"
    type="module"></script>
  <link
    rel="stylesheet"
    href="https://unpkg.com/photoswipe@5/dist/photoswipe.css"
  />
  <script type="module">
    import PhotoSwipeLightbox from "https://unpkg.com/photoswipe@5/dist/photoswipe-lightbox.esm.min.js";
    const lightbox = new PhotoSwipeLightbox({
      gallery: "#sale-gallery",
      children: "a",
      pswpModule: () =>
        import("https://unpkg.com/photoswipe@5/dist/photoswipe.esm.min.js"),
      showHideAnimationType: "none", // wyłącza animację powiększania
    });
    lightbox.init();
  </script>

  <section id="oferta" class="w-full py-14 md:py-16 bg-[var(--color-secondary)]">
    <div class="max-w-5xl mx-auto relative px-4 md:px-6">
      <div
        class="absolute inset-0 w-full h-full rounded-3xl bg-gradient-to-br from-white via-white to-black/5 blur-sm opacity-60 -z-10"
      >
      </div>
      <h2
        class="text-3xl md:text-4xl font-semibold text-center text-[var(--color-accent)] mb-10 tracking-wide"
      >
        Zorganizuj z nami niezapomniane wydarzenie
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div
          class="rounded-2xl shadow-xl bg-white p-8 flex flex-col items-center border border-black/20 hover:scale-[1.02] transition-transform duration-300 group"
        >
          <Icon
            name="mdi:party-popper"
            class="w-14 h-14 mb-4 transition-colors duration-300"
          />
          <h3
            class="text-2xl font-semibold text-[var(--color-accent)] mb-2 tracking-tight"
          >
            Przyjęcia okolicznościowe
          </h3>
          <p class="text-[var(--color-text)] text-center text-lg">
            Organizujemy wesela, jubileusze, urodziny i inne uroczystości w
            nowoczesnych wnętrzach z dostępem do ogrodu.
          </p>
        </div>
        <div
          class="rounded-2xl shadow-xl bg-white p-8 flex flex-col items-center border border-black/20 hover:scale-[1.02] transition-transform duration-300 group"
        >
          <Icon
            name="mdi:briefcase"
            class="w-14 h-14 mb-4 text-black transition-colors duration-300"
          />
          <h3
            class="text-2xl font-semibold text-[var(--color-accent)] mb-2 tracking-tight"
          >
            Spotkania biznesowe
          </h3>
          <p class="text-[var(--color-text)] text-center text-lg">
            Profesjonalna obsługa, elastyczne menu i komfortowe sale – idealne
            miejsce na konferencje, szkolenia czy bankiety.
          </p>
        </div>
        <div
          class="rounded-2xl shadow-xl bg-white p-8 flex flex-col items-center border border-black/20 hover:scale-[1.02] transition-transform duration-300 group"
        >
          <Icon
            name="mdi:account-group"
            class="w-14 h-14 mb-4 transition-colors duration-300"
          />
          <h3
            class="text-2xl font-semibold text-[var(--color-accent)] mb-2 tracking-tight"
          >
            Imprezy rodzinne
          </h3>
          <p class="text-[var(--color-text)] text-center text-lg">
            Chrzciny, komunie, roczki oraz studniówki – zadbamy o każdy detal,
            by ten dzień był wyjątkowy dla Ciebie i Twoich bliskich.
          </p>
        </div>
        <div
          class="rounded-2xl shadow-xl bg-white p-8 flex flex-col items-center border border-black/20 hover:scale-[1.02] transition-transform duration-300 group"
        >
          <Icon
            name="mdi:firework"
            class="w-14 h-14 mb-4 transition-colors duration-300"
          />
          <h3
            class="text-2xl font-semibold text-[var(--color-accent)] mb-2 tracking-tight"
          >
            Sylwester & Bale
          </h3>
          <p class="text-[var(--color-text)] text-center text-lg">
            Zaskocz gości niezapomnianą zabawą przy muzyce, pysznym jedzeniu i
            klimatycznym wystroju.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- sekcja kontakt + facebook obok siebie -->
  <div class="w-full bg-black py-14 md:py-16 border-y border-white/10">
    <div
      class="max-w-5xl mx-auto flex flex-col md:flex-row md:justify-between gap-8 w-full px-4 md:px-6"
    >
      <section
        id="kontakt"
        class="w-full md:w-[500px] max-w-[500px] mx-auto md:mx-0 pt-10 rounded-2xl bg-white shadow-xl relative overflow-hidden border border-black/20 mb-8 md:mb-0"
      >
        <div
          class="absolute inset-0 bg-gradient-to-br from-[var(--color-secondary)]/30 to-[var(--color-accent)]/10 blur-lg opacity-60 -z-10"
        >
        </div>
        <h2 class="text-3xl md:text-4xl font-semibold text-[var(--color-accent)] mb-8 tracking-wide text-center">
          Skontaktuj się z nami
        </h2>
        <div class="flex flex-col gap-5 items-start max-w-md mx-auto px-4">
          <div class="flex items-center gap-3 text-base md:text-lg text-[var(--color-text)] w-full">
            <Icon
              name="mdi:map-marker-radius-outline"
              class="w-6 h-6 text-[var(--color-accent)] flex-shrink-0"
            />
            <span class="text-sm md:text-base"
              >Tryńcza 284, 37-204, Tryńcza, podkarpackie</span
            >
          </div>
          
          <div class="flex items-center justify-between gap-3 text-base md:text-lg text-[var(--color-text)] w-full">
            <div class="flex items-center gap-3">
              <Icon
                name="mdi:phone-outline"
                class="w-6 h-6 text-[var(--color-accent)] flex-shrink-0"
              />
              <span class="font-medium mt-2">Telefon:</span>
            </div>
            <div class="flex items-center gap-2">
              <a
                href="tel:603363635"
                class="font-semibold text-[var(--color-primary)] hover:opacity-70 transition-colors"
                >603 363 635</a
              >
              <button
                type="button"
                onclick="navigator.clipboard.writeText('603363635'); this.querySelector('svg').classList.add('text-green-500'); setTimeout(() => this.querySelector('svg').classList.remove('text-green-500'), 1000);"
                class="p-1.5 rounded hover:bg-black/5 transition-colors focus:outline-none cursor-pointer"
                aria-label="Kopiuj numer telefonu"
                title="Kopiuj numer"
              >
                <Icon
                  name="mdi:content-copy"
                  class="w-4 h-4 text-[var(--color-accent)] transition-colors duration-200"
                />
              </button>
            </div>
          </div>
          
          <div class="flex items-center justify-between gap-3 text-base md:text-lg text-[var(--color-text)] w-full">
            <div class="flex items-center gap-3">
              <Icon
                name="mdi:facebook"
                class="w-6 h-6 text-[var(--color-accent)] flex-shrink-0"
              />
              <span class="font-medium mt-2">Facebook:</span>
            </div>
            <a
              href="https://www.facebook.com/profile.php?id=100057527347729"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 px-3 py-2 rounded-xl md:rounded-2xl bg-black text-white font-semibold border border-black/20 shadow-lg hover:shadow-2xl hover:-translate-y-0.5 transition-all duration-300 ease-out text-sm"
              style="box-shadow:0 10px 30px 0 rgba(0,0,0,0.14);"
              >Napisz teraz
              <Icon
                name="mdi:open-in-new"
                class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </a>
          </div>
        </div>
        <div class="mt-8 text-sm text-[var(--color-muted)] italic text-center px-4">
          Odpowiadamy szybko i z zaangażowaniem – napisz lub zadzwoń!
        </div>
        <img
          src={kontaktImg}
          alt="Kontakt Bocarlo"
          class="w-full h-48 object-cover object-top mt-8 bottom-0"
          loading="lazy"
        />
      </section>
      <div id="fb-root"></div>
      <script
        async
        defer
        crossorigin="anonymous"
        src="https://connect.facebook.net/pl_PL/sdk.js#xfbml=1&version=v23.0"
      ></script>
      <section
        class="w-full md:w-[500px] max-w-[500px] mx-auto md:mx-0 pt-8 px-0 text-center rounded-2xl bg-white shadow-xl relative overflow-hidden border border-black/20"
      >
        <div
          class="absolute inset-0 from-[var(--color-secondary)]/20 to-[var(--color-accent)]/10 blur-lg opacity-60 -z-10 overflow-hidden"
        >
        </div>
        <h2 class="text-3xl font-semibold text-[var(--color-accent)] mb-3 tracking-wide flex items-center justify-center gap-3">
          Jesteśmy na Facebooku
        </h2>
        <p class="text-md text-[var(--color-muted)] mb-4">
          Zobacz zdjęcia i aktualności z Domu Weselnego Bocarlo
        </p>
        <div class="overflow-hidden border border-gray-200 bg-white w-full">
          <div
            class="fb-page"
            data-href="https://www.facebook.com/profile.php?id=100057527347729&sk=photos"
            data-tabs="timeline"
            data-width="500"
            data-height="380"
            data-small-header="false"
            data-adapt-container-width="true"
            data-hide-cover="false"
            data-show-facepile="true"
          >
            <blockquote
              cite="https://www.facebook.com/profile.php?id=100057527347729&sk=photos"
              class="fb-xfbml-parse-ignore"
            >
              <a
                href="https://www.facebook.com/profile.php?id=100057527347729&sk=photos"
                >Dom Weselny Bocarlo</a
              >
            </blockquote>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- Mapy -->
  <section
    id="lokalizacje"
    class="w-full py-14 md:py-16 bg-[var(--color-background)] from-[var(--color-secondary)]/30 to-[var(--color-accent)]/10"
  >
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <div class="mb-8 text-center">
        <h2 class="text-3xl font-semibold text-[var(--color-accent)] mb-2">
          Lokalizacje
        </h2>
        <p class="text-[var(--color-muted)] text-lg">
          Dom Weselny Bocarlo – Tryńcza & Grodzisko Dolne
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="flex flex-col items-center">
          <div
            class="rounded-2xl shadow-xl overflow-hidden border border-black/20 bg-white w-full flex flex-col"
          >
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2555.5556927065577!2d22.538277676297888!3d50.16944567153985!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x473cbe45022eeeeb%3A0xc62623a20fc1fae3!2sDom%20Weselny%20Bocarlo%20Try%C5%84cza!5e0!3m2!1sen!2spl!4v1754522351341!5m2!1sen!2spl"
              width="100%"
              height="400"
              style="border:0; display:block; width:100%;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
            <div class="pt-4 text-center border-t border-black/20 bg-white">
              <h3 class="text-xl font-semibold text-[var(--color-accent)] mb-1">
                Tryńcza
              </h3>
              <p class="text-[var(--color-muted)]">
                Dom Weselny Bocarlo, Tryńcza 284
              </p>
              <img
                src={bocarlozt}
                alt="Dom Weselny Bocarlo Tryńcza"
                class="w-full h-80 object-cover object-bottom shadow-md mt-4"
                loading="lazy"
              />
            </div>
          </div>
        </div>
        <div class="flex flex-col items-center">
          <div
            class="rounded-2xl shadow-xl overflow-hidden border border-black/20 bg-white w-full flex flex-col"
          >
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2555.057861559209!2d22.44670417629844!3d50.178754471541595!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x473cc00c95d71c19%3A0xef0d261a5fdf7d1d!2sDom%20Weselny%20Bocarlo%20Grodzisko%20Dolne!5e0!3m2!1sen!2spl!4v1754522608210!5m2!1sen!2spl"
              width="100%"
              height="400"
              style="border:0; display:block; width:100%;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
            <div class="pt-4 text-center border-t border-black/20 bg-white">
              <h3 class="text-xl font-semibold text-[var(--color-accent)] mb-1">
                Grodzisko Dolne
              </h3>
              <p class="text-[var(--color-muted)]">
                Dom Weselny Bocarlo, Grodzisko Dolne 366
              </p>
              <img
                src={bocarlozg}
                alt="Dom Weselny Bocarlo Grodzisko Dolne"
                class="w-full h-80 object-cover object-bottom shadow-md mt-4"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const hero = document.getElementById("parallax-hero");
      if (!hero) return;
      const section = hero.closest("section");
      if (!section) return;

      let ticking = false;
      window.addEventListener("scroll", () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            const rect = section.getBoundingClientRect();
            const sectionH = section.offsetHeight;
            const progress = -rect.top / (sectionH + window.innerHeight);
            const offset = progress * 0.3 * sectionH;
            hero.style.transform = `translate3d(0, ${offset}px, 0)`;
            ticking = false;
          });
          ticking = true;
        }
      });
    });
  </script>
</Layout>
